{
  "name": "ninepatch-react",
  "version": "2.0.0",
  "description": "React component that renders Android nine-patch images",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/midi-zeng/ninepatch-react"
  },
  "keywords": [
    "react",
    "react-component",
    "ninepatch",
    "9-patch",
    "android"
  ],
  "author": "midi_zeng",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/midi-zeng/ninepatch-react/issues"
  },
  "homepage": "https://github.com/midi-zeng/ninepatch-react#readme",
  "scripts": {
    "dev": "pnpm run demo:dev",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src test demo",
    "typecheck": "tsc --noEmit && tsc --noEmit -p demo",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "demo:dev": "vite --config vite.config.demo.ts",
    "demo:build": "vite build --config vite.config.demo.ts",
    "demo:preview": "vite preview --config vite.config.demo.ts",
    "release": "pnpm run build && bumpp && pnpm publish"
  },
  "packageManager": "pnpm@12.4.2",
  "dependencies": {
    "ninepatch-core": "^2.0.0"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.52.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "bumpp": "^12.3.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.93.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.0",
    "unocss": "^66.12.0",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0"
  }
}
